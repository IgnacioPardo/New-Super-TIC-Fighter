{
  "name": "new-super-tic-fighter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview --host 127.0.0.1",
    "dev:server": "wrangler dev --port 8787",
    "deploy": "pnpm build && wrangler deploy",
    "e2e": "pnpm e2e:intro && pnpm e2e:app && pnpm e2e:devices && pnpm e2e:menus && pnpm e2e:controllers && pnpm e2e:lifecycle",
    "e2e:intro": "node scripts/app-intro.mjs",
    "e2e:app": "node scripts/app-browser.mjs",
    "e2e:devices": "node scripts/app-devices.mjs",
    "e2e:lifecycle": "node scripts/app-network-lifecycle.mjs",
    "e2e:transport": "node scripts/network-smoke.mjs && node scripts/network-browser.mjs",
    "e2e:menus": "node scripts/app-menus.mjs && node scripts/app-results-navigation.mjs",
    "e2e:audio": "node scripts/audio-http.mjs",
    "e2e:controllers": "node scripts/app-dualsense.mjs && node scripts/app-feedback.mjs",
    "e2e:audio-playback": "node scripts/app-audio.mjs"
  },
  "dependencies": {
    "phaser": "4.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261011.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "wrangler": "4.149.0"
  }
}
