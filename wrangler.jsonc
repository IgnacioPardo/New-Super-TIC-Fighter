{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "new-super-tic-fighter",
  "main": "server/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [{"binding":"DB","database_name":"new-super-tic-fighter-profiles","database_id":"56746be7-6196-4bde-aa0d-d48a3e557247","migrations_dir":"server/migrations"}],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/assets/audio/*.mp3"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }, { "name": "MATCHES", "class_name": "MatchDO" }, { "name": "LOBBY", "class_name": "LobbyDO" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2-matches", "new_sqlite_classes": ["MatchDO"] },
    { "tag": "v2-lobby", "new_sqlite_classes": ["LobbyDO"] }
  ]
}
